#include <SFML/Graphics.hpp>

int main() {
    // Create an 800x600 window titled "PacBot"
    sf::RenderWindow window(sf::VideoMode({ 800, 600 }), "PacBot");
    window.setFramerateLimit(60);

    // Keep running until the window is closed
    while (window.isOpen()) {
        while (const std::optional event = window.pollEvent()) {
            if (event->is<sf::Event::Closed>())
                window.close();
        }

        window.clear(sf::Color::Black);   // fill with black
        window.display();                 // show it
    }
}
